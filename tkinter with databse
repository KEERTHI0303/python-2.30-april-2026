import tkinter as tk
from tkinter import messagebox
import pymysql as p
# Main Window
root = tk.Tk()
root.title("Registration System")
root.geometry("500x350")
root.resizable(False, False)
# Registration Frame
register_frame = tk.LabelFrame(root, text="Registration", padx=20, pady=20)
register_frame.pack(pady=10)
tk.Label(register_frame, text="Username").grid(row=0, column=0, pady=5)
reg_username = tk.Entry(register_frame, width=25)
reg_username.grid(row=0, column=1)

tk.Label(register_frame, text="Password").grid(row=1, column=0, pady=5)
reg_password = tk.Entry(register_frame, show="*", width=25)
reg_password.grid(row=1, column=1)
def register():
    reg_name=reg_username.get()
    reg_pass=reg_password.get()
    s=p.connect( host="localhost",user="root",password="1234",database="hari")
    g=s.cursor()
    print(reg_name)
    print(reg_pass)
    #g.execute("create table madhan(username varchar(90),password varchar(8));")
    g.execute("insert into madhan values('"+reg_name+"','"+reg_pass+"')")
    s.commit()
    
tk.Button(register_frame, text="Register", command=register,
          bg="green", fg="white").grid(row=2, columnspan=2, pady=10)
